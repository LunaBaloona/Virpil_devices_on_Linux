# Builds elite-hotas-fix from the tagged source on github.
#   cd elite-hotas-fix/packaging/arch && makepkg -si

pkgname=elite-hotas-fix
pkgver=1.0.0
pkgrel=1
pkgdesc="Keep flight sticks and throttles working in Elite Dangerous (and other Proton games) on Linux"
arch=('x86_64')
url="https://github.com/LunaBaloona/Virpil_devices_on_Linux"
license=('GPL-3.0-or-later')
# the .cargo/config.toml in the source builds a fully static binary
depends=()
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
# build-packages.sh fills in the real hash from the pushed tag before running
# makepkg, because the archive can only be hashed after the tag exists on
# github. If you build with plain makepkg, replace SKIP with that hash first:
#   curl -sL $url/archive/v$pkgver.tar.gz | sha256sum
sha256sums=('SKIP')

# GitHub unpacks the archive with top directory Virpil_devices_on_Linux-$pkgver.
# Whether makepkg strips that single directory depends on its name heuristic,
# so enter the source dir in a way that is correct either way.
_enter_src() {
  cd "$srcdir"
  [[ -d Virpil_devices_on_Linux-$pkgver ]] && cd "Virpil_devices_on_Linux-$pkgver"
  cd elite-hotas-fix
}

prepare() {
  _enter_src
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  _enter_src
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  _enter_src
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  _enter_src
  install -Dm755 target/release/$pkgname "$pkgdir/usr/bin/$pkgname"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
