# AUR submission copy (packaging/aur/PKGBUILD + .SRCINFO go to the AUR
# repo as-is). For a future release: bump pkgver, reset pkgrel to 1, paste
# the new tag's archive hash, regenerate .SRCINFO, test-build, push.
pkgname=elite-hotas-fix
pkgver=1.0.1
pkgrel=1
pkgdesc="Keep flight sticks and throttles working in Elite Dangerous (and other Proton games) on Linux"
arch=('x86_64')
url="https://github.com/LunaBaloona/Virpil_devices_on_Linux"
license=('GPL-3.0-or-later')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('3c18a27d8ad9964a052caeef006a5eca24769c5a9a5ab3764c27d03fab4c3c90')

# GitHub unpacks the archive with top directory Virpil_devices_on_Linux-$pkgver.
# Whether makepkg strips that single directory depends on its name heuristic,
# so enter the source dir in a way that is correct either way.
_enter_src() {
  cd "$srcdir"
  [[ -d Virpil_devices_on_Linux-$pkgver ]] && cd "Virpil_devices_on_Linux-$pkgver"
  cd elite-hotas-fix
}

prepare() {
  _enter_src
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  _enter_src
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  _enter_src
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  _enter_src
  install -Dm755 target/release/$pkgname "$pkgdir/usr/bin/$pkgname"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
